# MPLADS Guardian — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local development — default)
DATABASE_URL=sqlite:///./data/guardian.db

# PostgreSQL (production — uncomment and fill in)
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres

# ── API ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Allowed frontend origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://mplads-insight-guard.vercel.app

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Directory to save raw API responses (relative to backend/)
RAW_DATA_DIR=./data/raw

# Directory to save validation reports
VALIDATION_DATA_DIR=./data/validation

# Session cache directory (stores eSAKSHI session cookies)
SESSION_DATA_DIR=./data

# Default Lok Sabha terms to fetch: "17", "18", or "both"
DEFAULT_LS_TERM=both

# Seconds to wait between API requests (be polite to the government server)
INTER_REQUEST_DELAY=1.0

# HTTP request timeout in seconds
REQUEST_TIMEOUT=120
